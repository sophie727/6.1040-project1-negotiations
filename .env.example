MONGODB_URL=mongodb://dev:dev@127.0.0.1:27017/myapp?authSource=admin
# Optional: a database other than the one MONGODB_URL names. Leave it unset on 6.1040 Apps.
#MONGODB_DB=wholepie

# The AI counterpart and coach write with Claude when ANTHROPIC_API_KEY is set, or with Gemini when GEMINI_API_KEY is set.
# Without either key, they answer with scripted stand-ins. The model lines are optional.

# for using parley:
ANTHROPIC_BASE_URL=https://parley.api.mit.edu
ANTHROPIC_API_KEY=sk-parley-v1-...your-key...
ANTHROPIC_MODEL=claude-sonnet-5-5

#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5-5
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.7-flash
